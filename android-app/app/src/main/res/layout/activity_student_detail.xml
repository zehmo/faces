<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/faces_green"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/navBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photo + Name Header (WhatsApp style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@android:color/white"
                android:paddingTop="24dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/imgPhoto"
                    android:layout_width="160dp"
                    android:layout_height="200dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"
                    android:contentDescription="Student photo"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvRegNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:textColor="#667781"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#667781" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Personal Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvJambReg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvSex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvMaritalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvLga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvTown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111B21"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Fee Status Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fee Status"
                    android:textSize="14sp"
                    android:textColor="#667781"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/feesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Navigation Bar -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Previous"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textStart"
            style="@style/Widget.Material3.Button.TonalButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            style="@style/Widget.Material3.Button.TonalButton" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
